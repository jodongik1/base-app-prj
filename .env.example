# ============================================================
# 앱 기본 설정 예시입니다. setup.sh가 최초 실행 시 .env로 복사합니다.
# .env가 이미 있으면 덮어쓰지 않습니다. 아래 계정은 로컬 개발용 예시이며 그대로 시작할 수 있습니다.
# 이 예시 자격 증명은 저장소에 공개됩니다. 운영 환경에서는 반드시 다른 값으로 바꾸세요.
# 비밀번호에 $ 등 Compose 치환 문자가 있으면 값을 작은따옴표로 감싸세요.
# ============================================================

# Docker Compose가 프론트엔드·백엔드 포트를 호스트의 어느 주소에 공개할지 정합니다.
# 127.0.0.1은 이 컴퓨터에서만 접속 가능하며, 0.0.0.0은 모든 호스트 인터페이스에서 접속을 받습니다.
# 컨테이너 내부 서버의 0.0.0.0은 Docker의 연결을 받기 위한 별도 설정입니다.
# Docker 없이 백엔드를 직접 실행할 때도 이 값을 백엔드 수신 주소로 사용합니다.
# 단, Docker 없이 실행하는 프론트엔드의 Vite 개발 서버에는 이 값이 적용되지 않습니다.
HOST_BIND_IP=127.0.0.1
# DB별 호스트 공개 범위는 웹·API 및 다른 DB와 독립적으로 적용됩니다.
# 127.0.0.1은 이 컴퓨터만, 0.0.0.0은 모든 호스트 인터페이스에서 접속을 받습니다.
# 외부 접속이 꼭 필요할 때만 해당 DB의 값을 0.0.0.0으로 바꾸고 방화벽을 구성하세요.
POSTGRES_BIND_IP=127.0.0.1
MONGO_BIND_IP=127.0.0.1
# Redis는 비밀번호를 설정해도 인터넷에 직접 공개하지 않는 것을 권장합니다.
REDIS_BIND_IP=127.0.0.1

# ── PostgreSQL ───────────────────────────────────────────────
# 로컬 개발용 PostgreSQL 접속 계정
POSTGRES_USER=app_pg
# 로컬 개발용 PostgreSQL 비밀번호
POSTGRES_PASSWORD=dev-postgres-8gH7pL2m
# 사용할 데이터베이스 이름
POSTGRES_DB=app
# 호스트와 컨테이너 내부에서 동일하게 사용할 포트
POSTGRES_PORT=5432

# ── MongoDB ──────────────────────────────────────────────────
# 로컬 개발용 MongoDB 루트(관리자) 계정
MONGO_ROOT_USER=mongo_admin
# 로컬 개발용 MongoDB 루트(관리자) 비밀번호
MONGO_ROOT_PASSWORD=dev-mongo-admin-9kR4qX6v
# 로컬 개발용 MongoDB 앱 전용 계정 (readWrite 권한만 부여)
MONGO_APP_USER=mongo_app
# 로컬 개발용 MongoDB 앱 전용 계정 비밀번호
MONGO_APP_PASSWORD=dev-mongo-app-5wN3jT8z
# 루트 계정의 인증 DB (admin에 생성됨)
MONGO_AUTH_SOURCE=admin
# 앱이 실제로 사용할 데이터베이스 이름
MONGO_DB=app
# 호스트와 컨테이너 내부에서 동일하게 사용할 포트
MONGO_PORT=27017

# ── Redis ────────────────────────────────────────────────────
# 로컬 개발용 Redis 비밀번호
REDIS_PASSWORD=dev-redis-7pD2sM4h
# 호스트와 컨테이너 내부에서 동일하게 사용할 포트
REDIS_PORT=6379

# ── 서비스 포트 ──────────────────────────────────────────────
# 백엔드 API 서버가 호스트와 컨테이너 내부에서 사용할 포트
BACKEND_PORT=8000
# 프론트엔드 개발 서버가 호스트와 컨테이너 내부에서 사용할 포트
FRONTEND_PORT=5173
