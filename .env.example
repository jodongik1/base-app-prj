# ============================================================
# Local development defaults.
# setup.sh copies this file to .env once (existing .env is preserved).
# Change values here for your local environment.
# ============================================================

# 호스트 공개 범위: 127.0.0.1은 이 컴퓨터에서만 접근 허용
HOST_BIND_IP=127.0.0.1
# DB 공개 범위는 웹 서비스와 별도로 설정
DB_BIND_IP=127.0.0.1

# ── PostgreSQL ───────────────────────────────────────────────
# 데이터베이스 접속 계정
POSTGRES_USER=app
# 데이터베이스 접속 비밀번호
POSTGRES_PASSWORD=change-me-on-setup
# 사용할 데이터베이스 이름
POSTGRES_DB=app
# 호스트와 컨테이너 내부에서 동일하게 사용할 포트
POSTGRES_PORT=5432

# ── MongoDB ──────────────────────────────────────────────────
# MongoDB 루트(관리자) 계정 이름
MONGO_ROOT_USER=app
# MongoDB 루트(관리자) 계정 비밀번호
MONGO_ROOT_PASSWORD=change-me-on-setup
# 인증에 사용할 데이터베이스 (루트 계정은 admin DB에 저장됨)
MONGO_AUTH_SOURCE=admin
# 앱이 실제로 사용할 데이터베이스 이름
MONGO_DB=app
# 호스트와 컨테이너 내부에서 동일하게 사용할 포트
MONGO_PORT=27017

# ── Redis ────────────────────────────────────────────────────
# 호스트와 컨테이너 내부에서 동일하게 사용할 포트
REDIS_PORT=6379

# ── 서비스 포트 ──────────────────────────────────────────────
# 백엔드 API 서버가 호스트와 컨테이너 내부에서 사용할 포트
BACKEND_PORT=8000
# 프론트엔드 개발 서버가 호스트와 컨테이너 내부에서 사용할 포트
FRONTEND_PORT=5173
